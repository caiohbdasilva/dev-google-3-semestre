        <mxCell id="G1-MviV9nqLSMMYQwDWC-60" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="0..1" vertex="1">
          <mxGeometry height="30" width="60" x="262" y="625" as="geometry" />
        </mxCell>
        <mxCell id="G1-MviV9nqLSMMYQwDWC-61" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="0..*" vertex="1">
          <mxGeometry height="30" width="60" x="260" y="815" as="geometry" />
        </mxCell>
        <mxCell id="G1-MviV9nqLSMMYQwDWC-62" edge="1" parent="1" source="G1-MviV9nqLSMMYQwDWC-45" style="endArrow=diamondThin;endFill=1;endSize=24;html=1;rounded=0;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="G1-MviV9nqLSMMYQwDWC-17" value="">
