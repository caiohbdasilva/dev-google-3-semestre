        <mxCell id="G1-MviV9nqLSMMYQwDWC-63" connectable="0" parent="G1-MviV9nqLSMMYQwDWC-62" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="possui" vertex="1">
          <mxGeometry relative="1" x="-0.1631" y="-3" as="geometry">
            <mxPoint x="-28" y="28" as="offset" />
